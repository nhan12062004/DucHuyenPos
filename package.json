{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --config frontend/vite.config.ts --port=3000 --host=0.0.0.0",
    "dev:backend": "concurrently \"npm run dev:backend:build\" \"npm run dev:backend:run\"",
    "dev:backend:build": "tsc -p backend/tsconfig.json -w --preserveWatchOutput",
    "dev:backend:run": "node --watch --env-file=backend/.env backend/dist/main.js",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build:backend": "tsc -p backend/tsconfig.json",
    "preview": "vite preview --config frontend/vite.config.ts",
    "start:backend": "node backend/dist/main.js",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "lint:backend": "tsc --noEmit -p backend/tsconfig.json",
    "clean": "powershell -Command \"if (Test-Path 'frontend/dist') { Remove-Item -LiteralPath 'frontend/dist' -Recurse -Force }; if (Test-Path 'backend/dist') { Remove-Item -LiteralPath 'backend/dist' -Recurse -Force }\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/platform-express": "^11.1.8",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
    "read-excel-file": "^9.2.0",
    "recharts": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
